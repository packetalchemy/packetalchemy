---
import { getCollection } from "astro:content";

const posts = await getCollection("blog");

posts.sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);

const latest = posts.slice(0, 3);
---

<section class="reveal max-w-6xl mx-auto px-8 py-20">

  <div class="flex items-center justify-between">

    <h2 class="text-3xl font-bold">
      Latest Articles
    </h2>

    <a
      href="/blog"
      class="text-blue-400 hover:text-blue-300 transition"
    >
      View all →
    </a>

  </div>

  <div class="grid md:grid-cols-3 gap-8 mt-10">

    {
      latest.map((post, i) => (

        <a
          href={`/blog/${post.id}/`}
          style={`transition-delay: ${i * 90}ms`}
          class="reveal group relative overflow-hidden rounded-2xl border border-gray-800 bg-[#111827]/70 p-7 hover:border-teal-400/40 hover:-translate-y-1 hover:shadow-[0_18px_50px_-16px_rgba(45,212,191,0.25)] transition-all duration-300"
        >
          <span class="absolute inset-x-0 top-0 h-[2px] bg-gradient-to-r from-blue-500 via-teal-400 to-sky-400 opacity-0 group-hover:opacity-100 transition-opacity duration-300"></span>

          <div class="text-xs uppercase tracking-widest text-blue-400">
            {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
          </div>

          <h3 class="text-2xl font-bold mt-4 group-hover:text-blue-400 transition">
            {post.data.title}
          </h3>

          <p class="text-gray-400 mt-4">
            {post.data.description}
          </p>

          {post.data.tags?.length > 0 && (
            <div class="flex flex-wrap gap-1.5 mt-4">
              {post.data.tags.slice(0, 2).map((tag: string) => (
                <span class="px-2 py-0.5 text-[11px] border border-white/10 rounded-md text-gray-400 bg-white/[0.02]">{tag}</span>
              ))}
            </div>
          )}

          <div class="mt-8 text-blue-400 font-semibold">
            Read →
          </div>

        </a>

      ))
    }

  </div>

</section>