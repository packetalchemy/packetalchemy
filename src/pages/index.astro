---
import MainLayout from '../layouts/MainLayout.astro';
import Features from '../components/Features.astro';
import LatestPosts from '../components/LatestPosts.astro';
import Hero from '../components/Hero.astro';
---

<MainLayout title="PacketAlchemy — Engineering Telecom Systems at Scale">

  <Hero />

  <Features />

  <LatestPosts />

  <!-- CTA Section -->
  <section class="max-w-5xl mx-auto px-6 md:px-10 py-20">
    <div class="rounded-2xl border border-white/5 bg-gradient-to-br from-blue-600/10 via-transparent to-teal-500/10 p-10 text-center">
      <h2 class="text-2xl md:text-3xl font-bold">
        Ready to Learn?
      </h2>
      <p class="text-gray-400 mt-3 max-w-lg mx-auto text-sm">
        Follow technical articles on network engineering, packet analysis, and the latest telecom developments — or take a structured learning path from EPC to 5G Core.
      </p>
      <div class="flex flex-wrap justify-center gap-4 mt-8">
        <a
          href="/blog"
          class="rounded-xl bg-blue-600 hover:bg-blue-500 transition-all px-6 py-3 font-semibold text-sm shadow-lg shadow-blue-600/20"
        >
          Start Reading →
        </a>
        <a
          href="/learning-paths"
          class="rounded-xl border border-white/10 hover:border-teal-400/40 hover:bg-white/5 transition-all px-6 py-3 font-semibold text-sm text-gray-300"
        >
          Learning Paths
        </a>
      </div>
      <p class="mt-8 text-xs text-gray-500">
        New deep-dives every week on
        <a href="https://instagram.com/packetalchemy" target="_blank" rel="noopener" class="text-teal-300 hover:text-teal-200 transition">Instagram</a>
        and
        <a href="https://t.me/PacketAlchemy" target="_blank" rel="noopener" class="text-sky-300 hover:text-sky-200 transition">Telegram</a>
        — source notes on
        <a href="https://github.com/packetalchemy" target="_blank" rel="noopener" class="text-gray-300 hover:text-white transition">GitHub</a>
      </p>
    </div>
  </section>

</MainLayout>
