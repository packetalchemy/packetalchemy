---
import I18nLayout from '../../layouts/I18nLayout.astro';
import { getLocale } from '../../i18n/index';
import Hero from '../../components/Hero.astro';
import Features from '../../components/Features.astro';
import LatestPosts from '../../components/LatestPosts.astro';

const lang = 'fa' as const;
const t = getLocale(lang);
---

<I18nLayout title="PacketAlchemy — مهندسی شبکه‌های مخابراتی" lang={lang}>

  <Hero />

  <Features />

  <LatestPosts />

  <!-- CTA Section -->
  <section class="max-w-5xl mx-auto px-6 md:px-10 py-20">
    <div class="rounded-2xl border border-white/5 bg-gradient-to-br from-blue-600/10 via-transparent to-teal-500/10 p-10 text-center">
      <h2 class="text-2xl md:text-3xl font-bold rtl">
        آماده یادگیری هستید؟
      </h2>
      <p class="text-gray-400 mt-3 max-w-lg mx-auto text-sm rtl">
        مقالات فنی درباره مهندسی شبکه، تحلیل پکت و آخرین تحولات تلکام رو اینجا دنبال کنید — یا از مسیرهای یادگیری ساخت‌یافته، از EPC تا 5G Core پیش برید.
      </p>
      <div class="flex flex-wrap justify-center gap-4 mt-8">
        <a href="/fa/blog" class="rounded-xl bg-blue-600 hover:bg-blue-500 transition-all px-6 py-3 font-semibold text-sm shadow-lg shadow-blue-600/20">
          شروع مطالعه →
        </a>
        <a href="/fa/learning-paths" class="rounded-xl border border-white/10 hover:border-teal-400/40 hover:bg-white/5 transition-all px-6 py-3 font-semibold text-sm text-gray-300">
          مسیرهای یادگیری
        </a>
      </div>
      <p class="mt-8 text-xs text-gray-500 rtl">
        هر هفته آموزش‌های عمیق تازه در
        <a href="https://instagram.com/packetalchemy" target="_blank" rel="noopener" class="text-teal-300 hover:text-teal-200 transition">اینستاگرام</a>
        و
        <a href="https://t.me/PacketAlchemy" target="_blank" rel="noopener" class="text-sky-300 hover:text-sky-200 transition">تلگرام</a>
        — یادداشت‌های منبع در
        <a href="https://github.com/packetalchemy" target="_blank" rel="noopener" class="text-gray-300 hover:text-white transition">گیت‌هاب</a>
      </p>
    </div>
  </section>

</I18nLayout>
